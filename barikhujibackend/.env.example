# Copy to .env and fill in. NEVER commit .env.
PORT=5000
NODE_ENV=development

# Local MongoDB, or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/barikhuji

# REQUIRED, at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Comma-separated list of exact frontend origins (scheme + host + port, no path, no trailing slash).
# Open the site on the SAME host name as the API (localhost with localhost) or session cookies will not be sent.
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

SESSION_NAME=bk.sid
SESSION_MAX_AGE_DAYS=7
# Defaults: secure=true only in production, sameSite=lax. Use sameSite=none only with HTTPS and COOKIE_SECURE=true.
# COOKIE_SECURE=
# COOKIE_SAMESITE=lax
# Number of reverse proxies in front of the app (0 for local dev; 1 on most PaaS hosts).
TRUST_PROXY=0
CSRF_HEADER=X-CSRF-Token
BCRYPT_ROUNDS=12

# Rate limits (defaults shown)
# RATE_LIMIT_WINDOW_MINUTES=15
# RATE_LIMIT_LOGIN_IP_MAX=20
# RATE_LIMIT_LOGIN_EMAIL_MAX=10
# RATE_LIMIT_REGISTER_MAX=10

# Used ONLY by `npm run create-admin`. Leave blank to be prompted instead, and remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Used ONLY by the integration tests. The database name MUST contain the word "test".
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/barikhuji_test
